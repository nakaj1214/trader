# 失敗通知（任意）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# J-Quants V2（必須）
JQUANTS_API_KEY=your-jquants-api-key
JQUANTS_PLAN=free
JQUANTS_DATA_DELAY_WEEKS=12

# EDINET（大量保有報告の診断用・任意。公式サイトでAPIキーを発行）
EDINET_API_KEY=

# snapshot 暗号化専用鍵（必須。JQUANTS_API_KEY とは別の固定値を使用）
SNAPSHOT_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Position Exit Monitor: Google Sheets サービスアカウントJSONとシートID（必須）
GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"your-project"}'
GOOGLE_SHEET_ID=your-google-sheet-id
