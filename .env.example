# OpenAI API (optional; ChatGPT Work/Scheduled can be used separately)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Sheets API (legacy/optional)
GOOGLE_CREDENTIALS_JSON=path/to/credentials.json

# Slack Incoming Webhook (legacy/optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# LINE Messaging API (legacy/optional)
LINE_CHANNEL_ACCESS_TOKEN=your-line-access-token
LINE_USER_ID=your-line-user-id

# J-Quants API（現在はFreeプラン。shadow蓄積では約12週間遅延を明示して扱う）
JQUANTS_API_KEY=your-jquants-api-key
JQUANTS_PLAN=free
JQUANTS_DATA_DELAY_WEEKS=12

# EDINET API v2（金融庁・無料。開示日時のPoint-in-Time検証に使用）
EDINET_API_KEY=your-edinet-api-key

# 以下は旧US株/外部補完機能用。短期売買専用JP構成では不要。
FINNHUB_API_KEY=your-finnhub-api-key
FMP_API_KEY=your-fmp-api-key
FRED_API_KEY=your-fred-api-key
